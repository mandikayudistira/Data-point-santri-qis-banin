# Copy this file to /etc/qipos/qipos-api.env and fill in real values.
# Never commit the real file or expose it through the web server.
NODE_ENV=production
PORT=8080

# PostgreSQL connection string:
DATABASE_URL=postgres://qipos_user:CHANGE_ME@127.0.0.1:5432/qipos

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Leave empty when Nginx serves the frontend and proxies /api on the same domain.
# For a separate frontend domain, use a comma-separated list:
# CORS_ORIGIN=https://qipos.example.com
CORS_ORIGIN=