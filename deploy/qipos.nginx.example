server {
    listen 80;
    listen [::]:80;
    server_name qipos.example.com;

    root /var/www/qipos/artifacts/sipos/dist/public;
    index index.html;

    # Keep /api in the upstream path. The Express app mounts routes at /api.
    location = /api {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback is required for Wouter routes after a browser refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }
}